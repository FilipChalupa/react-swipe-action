{
	"compilerOptions": {
		"declaration": true,
		"declarationDir": "dist",
		"rootDir": "src",
		"module": "esnext",
		"target": "ES2017",
		"lib": ["es6", "dom", "es2016", "es2017"],
		"sourceMap": true,
		"jsx": "react-jsx",
		"moduleResolution": "bundler",
		"allowSyntheticDefaultImports": true,
		"strictNullChecks": true,
		"esModuleInterop": true,
		"plugins": [
			{
				"name": "typescript-plugin-css-modules"
			}
		]
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "src/**/*.stories.*"]
}
